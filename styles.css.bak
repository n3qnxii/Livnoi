:root{--bg:#f4f2ec;--ink:#121719;--muted:#6d7470;--card:#fffdf8;--line:#dedbd2;--lime:#d9ff65;--mint:#c9f7df;--peach:#ffd2ae;--lav:#d9d1ff;--red:#e85f52;--green:#1e8f62;--yellow:#f1c84b;--shadow:0 14px 38px rgba(23,26,24,.11);--radius:24px}
*{box-sizing:border-box}html,body{margin:0;min-height:100%;background:var(--bg);color:var(--ink);font-family:Inter,ui-rounded,"SF Pro Rounded","SF Pro Display",system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif}button{font:inherit;color:inherit}button{-webkit-tap-highlight-color:transparent}.hidden{display:none!important}.app-shell{min-height:100vh;max-width:760px;margin:auto;padding:env(safe-area-inset-top) 18px calc(92px + env(safe-area-inset-bottom))}.app-header{height:78px;display:flex;align-items:center;gap:11px}.brand-mark,.nav-logo,.mini-logo,.metric-logo{border:0;background:var(--ink);color:var(--lime);display:inline-grid;place-items:center;font-weight:950;letter-spacing:-.06em}.brand-mark{width:42px;height:42px;border-radius:14px;box-shadow:inset 0 0 0 2px rgba(255,255,255,.08)}.brand-spark{transform:rotate(-7deg)}.brand-copy{display:flex;flex-direction:column;line-height:1}.brand-copy b{font-size:18px;letter-spacing:.13em}.brand-copy small{margin-top:6px;font-size:10px;color:var(--muted)}.header-stats{margin-left:auto}.stat-pill{display:flex;align-items:center;gap:6px;background:#fff;border:1px solid var(--line);border-radius:999px;padding:8px 11px;font-size:12px}.mini-logo{width:20px;height:20px;border-radius:7px;font-size:11px}.view{display:none;animation:fade .25s ease}.view.active{display:block}@keyframes fade{from{opacity:.3;transform:translateY(6px)}to{opacity:1;transform:none}}.hero-panel{background:var(--ink);color:white;border-radius:32px;padding:28px;min-height:280px;display:grid;grid-template-columns:1.25fr .75fr;align-items:end;position:relative;overflow:hidden;box-shadow:var(--shadow)}.hero-panel:before{content:"";position:absolute;inset:-40% -30% auto auto;width:280px;height:280px;background:radial-gradient(circle,var(--lime),transparent 65%);opacity:.25}.hero-panel h1{font-size:clamp(38px,11vw,66px);line-height:.92;letter-spacing:-.055em;margin:8px 0 14px;max-width:520px}.hero-panel p{color:#c6cbc8;font-size:15px;line-height:1.5;max-width:420px}.kicker{font-size:11px;font-weight:900;letter-spacing:.18em;color:#7e857f}.hero-panel .kicker{color:var(--lime)}.hero-orbit{height:130px;position:relative;display:grid;place-items:center}.orbital-ring{position:absolute;width:126px;height:126px;border:1px solid rgba(255,255,255,.2);border-radius:50%;animation:spin 8s linear infinite}.orbital-ring:after{content:"";width:12px;height:12px;background:var(--lime);border-radius:50%;position:absolute;top:-6px;left:50%}@keyframes spin{to{transform:rotate(360deg)}}.hero-logo{width:82px;height:82px;background:var(--lime);color:var(--ink);display:grid;place-items:center;border-radius:27px;font-size:52px;font-weight:950;transform:rotate(-6deg)}.level-strip{margin:14px 0 26px;background:#fff;border:1px solid var(--line);border-radius:20px;padding:15px;display:grid;grid-template-columns:auto 1fr auto;gap:12px;align-items:center}.level-strip div:first-child{display:flex;flex-direction:column}.level-strip small{color:var(--muted);font-size:10px;text-transform:uppercase;letter-spacing:.1em}.progress-track,.hp-track{height:10px;background:#ecebe5;border-radius:999px;overflow:hidden}.progress-track span{display:block;height:100%;background:var(--ink);border-radius:inherit}.section-title{display:flex;justify-content:space-between;align-items:end;margin:24px 2px 12px}.section-title h2,.page-head h1{margin:4px 0 0;font-size:30px;letter-spacing:-.045em}.text-btn{border:0;background:transparent;text-decoration:underline;font-weight:800}.game-grid{display:grid;gap:12px}.game-card{border:1px solid #d5d2c9;background:var(--card);border-radius:26px;padding:18px;display:grid;grid-template-columns:66px 1fr 38px;gap:14px;align-items:center;text-align:left;box-shadow:0 5px 0 rgba(18,23,25,.035);transition:.15s}.game-card:active{transform:scale(.985)}.game-card.vocab .game-icon{background:var(--lime)}.game-card.grammar .game-icon{background:var(--lav)}.game-card.crossword .game-icon{background:var(--peach)}.game-icon{width:66px;height:66px;border-radius:21px;display:grid;place-items:center}.game-icon span{width:38px;height:38px;background:var(--ink);color:#fff;border-radius:13px;display:grid;place-items:center;font-weight:950;font-size:20px}.game-card small{font-size:10px;letter-spacing:.12em;color:var(--muted);font-weight:900}.game-card h3{font-size:22px;margin:3px 0}.game-card p{margin:0;color:var(--muted);font-size:13px;line-height:1.35}.play-dot{width:36px;height:36px;border-radius:50%;background:var(--ink);color:#fff;display:grid;place-items:center;font-size:12px}.rhythm-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:10px}.metric{background:#fff;border:1px solid var(--line);border-radius:20px;padding:14px;display:flex;flex-direction:column;gap:5px}.metric-logo{width:28px;height:28px;border-radius:9px;font-size:14px}.metric strong{font-size:24px}.metric small{font-size:11px;color:var(--muted)}.page-head{padding:22px 2px 18px}.page-head h1{font-size:42px}.page-head p{color:var(--muted);max-width:520px}.focus-shell{background:var(--ink);color:white;border-radius:30px;padding:28px;text-align:center}.focus-logo{width:58px;height:58px;border-radius:20px;background:var(--lime);color:var(--ink);font-size:38px;font-weight:950;display:grid;place-items:center;margin:auto}.focus-time{font-size:66px;font-weight:900;letter-spacing:-.06em;margin:18px 0}.focus-options{display:grid;grid-template-columns:repeat(4,1fr);gap:8px}.focus-options button,.segmented button{border:1px solid rgba(255,255,255,.15);background:rgba(255,255,255,.07);color:white;padding:10px;border-radius:14px;font-weight:800}.focus-options .active{background:var(--lime);color:var(--ink)}.primary,.secondary{border:0;border-radius:16px;padding:15px 18px;font-weight:900}.primary{background:var(--lime);color:var(--ink);width:100%;margin-top:14px}.secondary{background:#fff;border:1px solid var(--line);width:100%;margin-top:12px}.focus-shell small{display:block;margin-top:10px;color:#afb5b2}.reader,.setting-card,.history-card{background:#fff;border:1px solid var(--line);border-radius:24px;padding:22px;margin-top:14px}.reader p{line-height:1.75;color:#3f4542}.level-badge{display:inline-block;background:var(--lime);padding:6px 10px;border-radius:999px;font-weight:900;font-size:11px}.progress-cards{display:grid;grid-template-columns:repeat(2,1fr);gap:10px}.progress-cards>div{background:#fff;border:1px solid var(--line);border-radius:22px;padding:18px}.progress-cards small{color:var(--muted)}.progress-cards strong{font-size:34px;display:block;margin-top:5px}.history-list{display:grid;gap:9px}.history-item{display:flex;justify-content:space-between;padding:12px;border-radius:14px;background:#f7f5ef}.history-empty{color:var(--muted);font-size:13px}.setting-card label{font-weight:900;font-size:18px;display:block;margin-bottom:12px}.setting-card>small{display:block;color:var(--muted);margin-top:10px}.segmented{display:grid;grid-template-columns:repeat(5,1fr);gap:7px}.segmented.wide{grid-template-columns:repeat(2,1fr)}.segmented button{background:#f1efe8;color:var(--ink);border-color:#e1ded4}.segmented button.active{background:var(--ink);color:white}.bottom-nav{position:fixed;left:50%;transform:translateX(-50%);bottom:max(10px,env(safe-area-inset-bottom));width:min(calc(100% - 24px),720px);height:72px;background:rgba(18,23,25,.94);backdrop-filter:blur(20px);border-radius:24px;display:grid;grid-template-columns:repeat(5,1fr);padding:8px;z-index:20;box-shadow:0 16px 40px rgba(0,0,0,.2)}.nav{border:0;background:transparent;color:#8f9792;border-radius:17px;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:4px}.nav.active{background:#fff;color:var(--ink)}.nav-logo{width:26px;height:26px;background:transparent;color:currentColor;border:2px solid currentColor;border-radius:8px;font-size:12px}.nav.active .nav-logo{background:var(--ink);color:var(--lime);border-color:var(--ink)}.nav small{font-size:9px;font-weight:800}
/* battle */
.battle-screen{position:fixed;inset:0;background:#111617;color:#fff;z-index:50;overflow:auto;padding:max(12px,env(safe-area-inset-top)) 14px max(18px,env(safe-area-inset-bottom));display:flex;flex-direction:column}.battle-hud{display:grid;grid-template-columns:44px 1fr auto;align-items:center;gap:10px;max-width:820px;width:100%;margin:0 auto 10px}.hud-btn{width:42px;height:42px;border-radius:14px;border:1px solid rgba(255,255,255,.16);background:#202627;color:#fff;font-size:26px}.battle-title{text-align:center;display:flex;flex-direction:column}.battle-title small{font-size:10px;letter-spacing:.15em;color:#9fa6a2}.battle-title b{font-size:13px}.score-chip{background:#202627;border:1px solid rgba(255,255,255,.1);padding:8px 10px;border-radius:14px;display:flex;align-items:center;gap:6px}.arena{height:min(33vh,280px);min-height:210px;max-width:820px;width:100%;margin:0 auto;border-radius:28px;background:linear-gradient(#ccebdc 0 58%,#b8d89f 58%);position:relative;overflow:hidden;border:1px solid rgba(255,255,255,.08)}.arena:after{content:"";position:absolute;left:-10%;right:-10%;bottom:-26px;height:110px;background:#8ab970;border-radius:50%}.sky-dot{position:absolute;background:#fff;border-radius:99px;opacity:.7}.d1{width:70px;height:18px;top:28px;left:12%}.d2{width:96px;height:22px;top:55px;right:15%}.d3{width:45px;height:14px;top:20px;right:42%}.hero-character,.villain{position:absolute;bottom:34px;width:90px;height:120px;z-index:3;transition:transform .35s ease}.hero-character{left:12%}.villain{right:12%}.hero-head{width:46px;height:46px;border-radius:50%;background:#f0c69e;position:absolute;top:6px;left:22px;border:5px solid #2a3432}.hero-body{position:absolute;bottom:6px;left:12px;width:66px;height:72px;background:#e9ff99;border-radius:28px 28px 18px 18px;border:5px solid #2a3432;display:grid;place-items:center}.hero-body span{font-size:34px;font-weight:950;color:#202827}.hero-shadow,.villain-shadow{position:absolute;width:82px;height:18px;background:rgba(0,0,0,.14);bottom:-5px;border-radius:50%;z-index:-1}.villain-ears:before,.villain-ears:after{content:"";position:absolute;width:29px;height:42px;background:#9f6fc7;top:2px;border:5px solid #2a3432;border-radius:70% 20% 70% 20%}.villain-ears:before{left:6px;transform:rotate(-28deg)}.villain-ears:after{right:6px;transform:scaleX(-1) rotate(-28deg)}.villain-face{position:absolute;top:18px;left:15px;width:60px;height:52px;border-radius:45% 45% 55% 55%;background:#b987dd;border:5px solid #2a3432;z-index:2}.villain-face i{position:absolute;top:18px;width:8px;height:8px;background:#222;border-radius:50%}.villain-face i:first-child{left:13px}.villain-face i:last-child{right:13px}.villain-body{position:absolute;bottom:5px;left:8px;width:74px;height:65px;background:#9469bd;border:5px solid #2a3432;border-radius:35px 35px 22px 22px}.energy-shot{position:absolute;width:34px;height:34px;border-radius:50%;background:radial-gradient(circle,#fff 0 18%,var(--lime) 25% 62%,transparent 70%);left:25%;bottom:105px;opacity:0;z-index:5;filter:drop-shadow(0 0 10px var(--lime))}.energy-shot.fire{animation:shot .55s ease-out}.energy-shot.backfire{animation:backshot .55s ease-out;background:radial-gradient(circle,#fff 0 18%,#ff9b8d 25% 62%,transparent 70%);filter:drop-shadow(0 0 10px #ff9b8d)}@keyframes shot{0%{opacity:1;transform:translateX(0) scale(.7)}90%{opacity:1;transform:translateX(46vw) scale(1.2)}100%{opacity:0;transform:translateX(48vw)}}@keyframes backshot{0%{opacity:1;left:73%;transform:translateX(0)}90%{opacity:1;left:73%;transform:translateX(-48vw)}100%{opacity:0;left:73%;transform:translateX(-49vw)}}.villain.advance{transform:translateX(-40px)}.villain.hit{animation:wobble .45s}.hero-character.hit{animation:wobble .45s}@keyframes wobble{0%,100%{transform:translateX(0) rotate(0)}30%{transform:translateX(-10px) rotate(-7deg)}60%{transform:translateX(8px) rotate(6deg)}}.friend-bubble{position:absolute;right:8%;top:18px;background:white;color:#111;padding:10px 14px;border-radius:999px;font-weight:900;z-index:8;animation:pop .4s ease}@keyframes pop{from{transform:scale(.3)}to{transform:scale(1)}}.hp-zone{max-width:820px;width:100%;margin:10px auto 0;background:#1d2424;border-radius:18px;padding:12px}.hp-label,.enemy-hp{display:grid;grid-template-columns:110px 1fr 34px;align-items:center;gap:8px;font-size:9px;font-weight:900;letter-spacing:.08em}.hp-label{grid-template-columns:110px 1fr 34px}.hp-label .hp-track{grid-column:2}.hp-label span{grid-row:1}.hp-track{height:9px;background:#394142}.hp-track>span{display:block;height:100%;width:100%;background:#a9f06d;border-radius:999px;transition:width .35s}.enemy-hp{margin-top:8px}.enemy-hp .rival span{background:#c897ef}.timer-bar{max-width:820px;width:100%;margin:10px auto 0;height:28px;background:#292f2f;border-radius:14px;overflow:hidden;position:relative}.timer-bar span{display:block;height:100%;background:linear-gradient(90deg,var(--lime),#f8db63);width:100%;transition:width .1s linear}.timer-bar b{position:absolute;inset:0;display:grid;place-items:center;font-size:12px;color:#111}.question-zone{max-width:820px;width:100%;margin:10px auto 0;flex:1;background:#f7f5ef;color:var(--ink);border-radius:28px;padding:18px;display:flex;flex-direction:column}.question-meta{display:flex;justify-content:space-between;font-size:10px;letter-spacing:.1em;font-weight:900;color:var(--muted)}.question-zone h1{font-size:clamp(30px,8vw,54px);line-height:1.02;letter-spacing:-.045em;margin:14px 0 7px;text-align:center}.question-zone>p{text-align:center;margin:0 0 16px;color:var(--muted)}.answers{display:grid;grid-template-columns:repeat(2,1fr);gap:10px;margin-top:auto}.answer-btn{min-height:74px;border:2px solid #ddd9cf;background:#fff;border-radius:20px;padding:14px;font-size:clamp(18px,5vw,26px);font-weight:850;line-height:1.1;box-shadow:0 4px 0 #ddd9cf;transition:.12s}.answer-btn:active{transform:translateY(2px);box-shadow:0 2px 0 #ddd9cf}.answer-btn.correct{background:#d8f9cc;border-color:#62af6b;box-shadow:0 4px 0 #62af6b}.answer-btn.wrong{background:#ffd5cf;border-color:#e06a5e;box-shadow:0 4px 0 #e06a5e}.battle-feedback{text-align:center;font-weight:900;padding:9px}.battle-feedback.good{color:var(--green)}.battle-feedback.bad{color:var(--red)}
/* crossword */
.crossword-screen{background:#f4f2ec;color:var(--ink)}.crossword-screen .battle-hud{color:#fff}.crossword-content{max-width:900px;width:100%;margin:auto;display:grid;grid-template-columns:1fr;gap:16px}.crossword-grid{display:grid;grid-template-columns:repeat(9,1fr);gap:3px;background:#171c1d;padding:7px;border-radius:18px;aspect-ratio:1/1}.cw-cell{background:#fff;border:0;border-radius:5px;position:relative;display:grid;place-items:center;min-width:0}.cw-cell.block{background:#171c1d}.cw-cell input{width:100%;height:100%;border:0;background:transparent;text-align:center;text-transform:uppercase;font-size:clamp(14px,4vw,25px);font-weight:900;outline:none}.cw-cell .num{position:absolute;top:2px;left:3px;font-size:8px;color:#666}.crossword-clues{background:#fff;border:1px solid var(--line);border-radius:22px;padding:18px}.crossword-clues h2{margin-top:0}.clue{padding:9px 0;border-bottom:1px solid #eee;font-size:13px}.clue b{display:inline-block;min-width:24px}
.toast{position:fixed;left:50%;bottom:110px;transform:translateX(-50%);background:#111;color:#fff;padding:11px 16px;border-radius:999px;z-index:100;font-size:12px;font-weight:800;box-shadow:var(--shadow)}
@media(max-width:520px){.app-shell{padding-left:12px;padding-right:12px}.hero-panel{grid-template-columns:1fr;padding:23px;min-height:330px}.hero-orbit{position:absolute;right:12px;bottom:8px;width:110px}.hero-logo{width:64px;height:64px;font-size:42px}.orbital-ring{width:98px;height:98px}.level-strip{grid-template-columns:1fr auto}.level-strip .progress-track{grid-column:1/3}.game-card{grid-template-columns:58px 1fr 34px;padding:14px}.game-icon{width:58px;height:58px}.rhythm-grid{gap:7px}.metric{padding:11px}.metric strong{font-size:20px}.answers{grid-template-columns:1fr}.answer-btn{min-height:60px;font-size:20px}.arena{height:225px}.hero-character{left:8%}.villain{right:8%}.question-zone{padding:15px}.question-zone h1{font-size:34px}.hp-label,.enemy-hp{grid-template-columns:92px 1fr 30px}.bottom-nav{height:68px}.nav small{display:none}.nav-logo{width:32px;height:32px}.crossword-grid{gap:2px;padding:5px}}
@media(min-width:760px){.crossword-content{grid-template-columns:minmax(440px,1.1fr) minmax(260px,.9fr)}.battle-screen{padding-left:24px;padding-right:24px}}
/* LIVNOI V1.1 hero-game additions */
:root{--hero-font:Impact,'Arial Black','Trebuchet MS',system-ui,sans-serif}
.battle-screen,.battle-screen button,.battle-screen h1,.battle-screen b{font-family:var(--hero-font);letter-spacing:.025em}
.battle-tools{display:flex;gap:8px;align-items:center}.hud-btn.small{width:42px;height:42px;font-size:14px}.hint-chip{font:800 12px/1 system-ui,sans-serif;white-space:nowrap}
.pause-overlay,.result-overlay{position:fixed;inset:0;z-index:120;background:rgba(5,10,14,.82);backdrop-filter:blur(12px);display:grid;place-items:center;padding:24px}.pause-card,.result-card{width:min(430px,94vw);background:#171d20;border:1px solid rgba(255,255,255,.12);border-radius:28px;padding:24px;box-shadow:0 30px 80px rgba(0,0,0,.45);text-align:center}.pause-card h2,.result-card h2{font:900 34px/1 var(--hero-font);margin:8px 0 18px}.pause-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px}.pause-grid button,.result-card button{min-height:54px;border-radius:16px;border:1px solid rgba(255,255,255,.12);background:#252e32;color:#fff;font-weight:900}.pause-grid .primary,.result-card .primary{background:#d7ff45;color:#111}.result-score{font:900 68px/1 var(--hero-font);color:#d7ff45;margin:8px 0}.result-best{font:800 18px system-ui,sans-serif;margin-bottom:22px}.settings-toggle{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:14px 0;border-top:1px solid rgba(255,255,255,.08)}.switch{min-width:76px;border-radius:999px;padding:8px 12px;border:1px solid rgba(255,255,255,.14);background:#283035;color:#fff;font-weight:900}.switch.on{background:#d7ff45;color:#111}
.arena{transition:background .65s ease,filter .4s ease}.arena.scene-mall{background:linear-gradient(#bde9ff 0 44%,#eef2f0 44% 60%,#9ca5aa 60% 63%,#d6d1c7 63%)}.arena.scene-ring{background:linear-gradient(#151827 0 48%,#29233a 48% 60%,#c84b55 60% 63%,#30343a 63%)}.arena.scene-airport{background:linear-gradient(#ffcc9b 0 42%,#f0b0a0 42% 52%,#606c78 52% 55%,#30383d 55%)}.arena.scene-sunset{background:linear-gradient(#ff8b70 0 34%,#f6c27a 34% 50%,#4d8ca5 50% 75%,#17384a 75%)}.arena.scene-storm{background:linear-gradient(#1d2535 0 48%,#465267 48% 54%,#242a31 54%)}
.arena.scene-mall:before,.arena.scene-ring:before,.arena.scene-airport:before,.arena.scene-sunset:before,.arena.scene-storm:before{content:'';position:absolute;inset:auto 5% 8% 5%;height:34%;border-radius:18px;opacity:.32;pointer-events:none}.arena.scene-mall:before{background:repeating-linear-gradient(90deg,#fff 0 9%,transparent 9% 14%)}.arena.scene-ring:before{border:5px solid #e7edf0;background:linear-gradient(90deg,transparent 48%,#e7edf0 49% 51%,transparent 52%)}.arena.scene-airport:before{background:repeating-linear-gradient(90deg,transparent 0 14%,#fff 14% 18%,transparent 18% 30%)}.arena.scene-sunset:before{background:radial-gradient(circle at 72% 5%,#ffe77a 0 18%,transparent 19%)}.arena.scene-storm:before{background:repeating-linear-gradient(120deg,transparent 0 22%,rgba(255,255,255,.35) 23% 24%,transparent 25% 42%)}
.hero-character{left:18%!important}.villain{right:18%!important}.villain.advance{transform:translateX(-7vw)!important}.energy-shot{z-index:8}.screen-shake{animation:screenShake .28s linear}@keyframes screenShake{25%{transform:translateX(-4px)}50%{transform:translateX(4px)}75%{transform:translateX(-2px)}}
@media(max-width:600px){.battle-hud{padding:10px 12px}.battle-title b{font-size:13px}.score-chip{padding:8px 10px}.arena{min-height:29vh}.question-zone h1{font-size:clamp(30px,9vw,48px)}.answers{gap:9px}.answer-btn{min-height:58px;font-size:clamp(18px,5vw,23px)}.hero-character{left:14%!important}.villain{right:14%!important}}

/* LIVNOI V1.2 — anime game refresh */
:root{--anime-ink:#17203b;--anime-blue:#77c7ff;--anime-pink:#ff98c7;--anime-yellow:#ffe272;--anime-violet:#8e7dff;--anime-paper:#fffdf8}
body{background:radial-gradient(circle at 15% 5%,#dff5ff 0 14%,transparent 32%),radial-gradient(circle at 90% 18%,#ffe7f3 0 12%,transparent 30%),linear-gradient(180deg,#f8fcff,#fff8f4 60%,#f6f2ff);color:var(--anime-ink)}
.app-header{background:rgba(255,255,255,.76);border:1px solid rgba(23,32,59,.08);backdrop-filter:blur(18px);border-radius:0 0 26px 26px;box-shadow:0 8px 28px rgba(72,82,135,.08)}
.brand-mark,.nav-logo,.metric-logo,.mini-logo,.focus-logo{background:linear-gradient(145deg,var(--anime-blue),var(--anime-violet));color:white;border:2px solid white;box-shadow:0 5px 0 rgba(23,32,59,.12)}
.hero-panel{background:linear-gradient(135deg,#18315c 0%,#5f5bd9 52%,#fd9bc7 100%);border:3px solid rgba(255,255,255,.85);box-shadow:0 18px 50px rgba(65,70,135,.22);overflow:hidden}
.hero-panel:after{content:'✦';position:absolute;right:8%;top:8%;font-size:56px;color:#fff7a9;opacity:.8;transform:rotate(12deg)}
.game-card,.metric,.setting-card,.history-card,.reader,.anime-watch-card{background:rgba(255,255,255,.9);border:2px solid rgba(66,77,132,.1);box-shadow:0 10px 28px rgba(75,85,135,.09)}
.game-card{position:relative;overflow:hidden}.game-card:before{content:'';position:absolute;width:80px;height:80px;border-radius:50%;right:-28px;top:-28px;background:linear-gradient(135deg,rgba(119,199,255,.25),rgba(255,152,199,.2))}
.game-icon{background:linear-gradient(145deg,#fff,#e7f8ff);border:2px solid #9cd9ff;color:#4050aa;box-shadow:0 5px 0 #cfefff}.play-dot{background:#1f2c55;color:white}
.bottom-nav{background:rgba(255,255,255,.88);backdrop-filter:blur(20px);border-top:1px solid rgba(23,32,59,.08)}
.nav.active{color:#5360cf}.nav.active .nav-logo{transform:translateY(-4px) scale(1.06)}
.page-head h1,.section-title h2,.hero-panel h1{font-family:'Trebuchet MS','Arial Rounded MT Bold',system-ui,sans-serif;font-weight:900;letter-spacing:-.04em}

/* two-choice battle: oversized anime decision cards */
.answers{grid-template-columns:repeat(2,minmax(0,1fr));gap:14px}.answer-btn{min-height:96px;border-radius:26px;border:3px solid #d8e4f3;background:linear-gradient(180deg,#fff,#f8fbff);box-shadow:0 7px 0 #cad7e8;font-family:'Trebuchet MS',system-ui,sans-serif;font-weight:900}.answer-btn:nth-child(1){border-color:#bfe4ff}.answer-btn:nth-child(2){border-color:#ffd0e3}.answer-btn.correct{background:linear-gradient(180deg,#e9ffd9,#c7f5ae)}.answer-btn.wrong{background:linear-gradient(180deg,#ffe4e8,#ffc1ca)}
.battle-screen{background:linear-gradient(180deg,#121936,#25356b 52%,#12152a)}.battle-hud,.hp-zone,.timer-bar{box-shadow:0 7px 22px rgba(0,0,0,.2)}
.arena{border:3px solid rgba(255,255,255,.55);box-shadow:inset 0 0 0 2px rgba(51,63,111,.22),0 14px 34px rgba(0,0,0,.18)}
.question-zone{border:3px solid rgba(255,255,255,.8);box-shadow:0 -8px 26px rgba(10,17,48,.18)}
.hero-head:before{content:'';position:absolute;left:-8px;top:-13px;width:58px;height:30px;background:#15204b;clip-path:polygon(0 70%,20% 20%,32% 58%,49% 0,63% 55%,84% 15%,100% 75%,80% 64%,55% 78%,30% 62%);z-index:3}.hero-head:after{content:'';position:absolute;width:9px;height:9px;background:#21305b;border-radius:50%;left:16px;top:19px;box-shadow:20px 0 #21305b}.hero-body{background:linear-gradient(160deg,#77c7ff,#6570e8)}
.villain-face{background:linear-gradient(160deg,#ff9bc7,#a77dff)}.villain-body{background:linear-gradient(160deg,#9a7df6,#6b55b5)}
.friend-bubble{background:#fff9bd;color:#24305c;border:2px solid #fff;box-shadow:0 6px 0 #d4c857}

/* anime focus/watch room */
.anime-focus-shell{background:linear-gradient(145deg,#172957,#594fa8 58%,#f08fb9);border:3px solid white;box-shadow:0 16px 46px rgba(57,58,117,.25)}
.focus-topline{display:flex;align-items:center;justify-content:center;gap:14px}.focus-topline small{display:block;color:#cfe6ff;font-weight:900;letter-spacing:.14em}.anime-watch-card{margin-top:16px;border-radius:30px;padding:16px;overflow:hidden;position:relative}.anime-watch-card:before{content:'';position:absolute;right:-55px;top:-55px;width:160px;height:160px;border-radius:50%;background:radial-gradient(circle,#fff7ad 0 18%,#ffb4d1 19% 42%,transparent 43%);opacity:.55}.watch-card-head{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:12px}.video-frame{aspect-ratio:16/9;border-radius:24px;overflow:hidden;background:#10172f;border:3px solid #dceaff;box-shadow:0 8px 0 #d7e3f2}.video-frame iframe{width:100%;height:100%;border:0}.anime-watch-card h2{font:900 clamp(24px,6vw,38px)/1.05 'Trebuchet MS',system-ui,sans-serif;color:#24305b;margin:20px 4px 8px}.watch-note{font-size:12px;color:#6b7190;margin:0 4px 16px}.focus-lines{display:grid;gap:10px}.focus-line{display:grid;grid-template-columns:38px 1fr auto;gap:12px;align-items:center;padding:13px;border:2px solid #e6e8f6;border-radius:20px;background:linear-gradient(115deg,#fff,#f7fbff 60%,#fff3f9)}.line-no{width:34px;height:34px;border-radius:12px;display:grid;place-items:center;background:#273762;color:#fff;font-weight:900}.focus-line strong{display:block;font-size:clamp(19px,5vw,27px);letter-spacing:.01em}.focus-line small{display:block;color:#82719d;font-weight:800;margin:3px 0}.focus-line p{margin:0;color:#4d596e;font-size:14px}.speak-line{border:0;border-radius:14px;background:linear-gradient(145deg,#78c9ff,#7573e8);color:#fff;font-weight:900;padding:12px 10px;box-shadow:0 4px 0 #5559b8}

@media(max-width:600px){.answers{grid-template-columns:1fr 1fr}.answer-btn{min-height:82px;padding:10px 8px;font-size:clamp(17px,4.9vw,22px)}.focus-line{grid-template-columns:32px 1fr auto;gap:8px;padding:11px}.line-no{width:30px;height:30px}.speak-line{padding:10px 8px;font-size:11px}.anime-watch-card{padding:12px}.video-frame{border-radius:18px}}
@media(max-width:390px){.answers{gap:8px}.answer-btn{font-size:17px;min-height:78px}.focus-line strong{font-size:18px}.focus-line p{font-size:13px}}

/* Focus short-story reader */
.anime-story-card{margin-top:16px;border-radius:30px;padding:16px;overflow:hidden;position:relative;background:linear-gradient(155deg,rgba(255,255,255,.97),rgba(246,249,255,.95) 52%,rgba(255,242,249,.96));border:2px solid rgba(66,77,132,.1);box-shadow:0 12px 32px rgba(75,85,135,.11)}
.story-actions{display:flex;gap:8px;flex-wrap:wrap;justify-content:flex-end}.text-btn.alt{background:#fff0f6;color:#8a3f69;border-color:#ffd0e2}.story-art{height:130px;border-radius:24px;position:relative;overflow:hidden;background:linear-gradient(#8099f3 0 45%,#f8a7b8 46% 64%,#483c72 65%);border:3px solid #e6ecff;margin:4px 0 18px}.story-moon{position:absolute;width:48px;height:48px;border-radius:50%;background:#fff6bd;right:24px;top:18px;box-shadow:0 0 28px #fff1a8}.story-city{position:absolute;left:0;right:0;bottom:0;height:48px;background:linear-gradient(90deg,#2f3155 0 13%,transparent 13% 17%,#343862 17% 31%,transparent 31% 35%,#282c4e 35% 52%,transparent 52% 56%,#363963 56% 73%,transparent 73% 78%,#292d50 78%)}.story-hero{position:absolute;left:24px;bottom:23px;width:48px;height:48px;border-radius:50% 50% 44% 44%;display:grid;place-items:center;background:linear-gradient(145deg,#fff,#d9e7ff);color:#334276;font:1000 24px/1 system-ui;box-shadow:0 7px 0 rgba(32,37,84,.28),0 0 0 5px rgba(255,255,255,.28)}
.anime-story-card h2{font:900 clamp(25px,6vw,38px)/1.05 'Trebuchet MS',system-ui,sans-serif;color:#24305b;margin:0 2px 6px}.story-meta{font-size:12px;color:#7a80a0;font-weight:800;margin:0 2px 14px}.short-story-text{font-size:clamp(18px,4.8vw,23px);line-height:1.75;color:#313852;background:rgba(255,255,255,.74);border:2px solid #e7eafd;border-radius:22px;padding:16px}.short-story-text p{margin:0 0 12px}.short-story-text p:last-child{margin-bottom:0}.story-vocab{display:flex;gap:8px;flex-wrap:wrap;margin-top:13px}.story-chip{border-radius:999px;padding:8px 11px;background:#f0f3ff;border:1px solid #dbe1ff;color:#47517c;font-size:12px;font-weight:850}.story-chip b{color:#25325c}
@media(max-width:600px){.anime-story-card{padding:12px}.story-art{height:112px;border-radius:19px}.story-actions{gap:5px}.story-actions .text-btn{padding:8px 10px;font-size:11px}.short-story-text{padding:14px;font-size:18px;line-height:1.68}}

/* LIVNOI V1.4 — readability + airplane focus */
:root{--ink:#fff;--navy:#f7fbff;--muted:#d6e1ef}
.text-btn{color:#fff!important;border-color:rgba(255,255,255,.35)!important}
.question-zone{background:linear-gradient(180deg,rgba(6,18,40,.94),rgba(5,12,30,.98));color:#fff}
.question-zone h1,#battleQuestion,#battleHint,.question-meta,#questionDirection,#comboText{color:#fff!important;text-shadow:0 2px 10px rgba(0,0,0,.35)}
.answer-btn{color:#fff!important;background:linear-gradient(180deg,#24375d,#142440)!important;border-color:rgba(255,255,255,.24)!important;font-weight:800}
.answer-btn.correct{background:linear-gradient(180deg,#177e5f,#0f5945)!important}.answer-btn.wrong{background:linear-gradient(180deg,#9d3648,#6b2030)!important}
.hint-chip{display:flex!important;align-items:center;gap:8px;min-width:68px;justify-content:center}
.hint-star{width:20px;height:20px;display:inline-block;background:linear-gradient(135deg,#fff4b1,#ffd46b);clip-path:polygon(50% 0,61% 34%,98% 36%,68% 57%,79% 93%,50% 71%,21% 93%,32% 57%,2% 36%,39% 34%);filter:drop-shadow(0 0 6px rgba(255,225,120,.45))}

.flight-board{margin:12px 0 16px;padding:18px;border-radius:26px;background:linear-gradient(145deg,#102b4f,#183d67 55%,#235784);border:1px solid rgba(255,255,255,.2);box-shadow:0 18px 50px rgba(0,0,0,.25);position:relative;overflow:hidden}
.flight-board:after{content:"";position:absolute;right:-45px;top:-55px;width:150px;height:150px;border:1px solid rgba(255,255,255,.16);border-radius:50%;box-shadow:0 0 0 26px rgba(255,255,255,.03),0 0 0 52px rgba(255,255,255,.02)}
.flight-board-top{display:flex;justify-content:space-between;align-items:center;margin-bottom:18px}.flight-board-top b{letter-spacing:.14em}
.flight-route{display:grid;grid-template-columns:1fr minmax(70px,1fr) 1fr;gap:12px;align-items:center}.flight-route>div:first-child,.flight-route>div:last-child{display:flex;flex-direction:column}.flight-route strong{font-size:clamp(32px,10vw,54px);line-height:1}.flight-route small{opacity:.65;letter-spacing:.16em}.flight-route span{opacity:.85}
.route-line{display:flex;align-items:center;gap:5px}.route-line span{height:1px;background:rgba(255,255,255,.45);flex:1}.route-line b{font-size:22px;transform:rotate(20deg)}
.flight-actions{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:18px}.flight-actions button{min-height:48px}.flight-board #ticketStatus{display:block;margin-top:10px;opacity:.78}
.airplane-cabin{background:linear-gradient(160deg,#0c2038,#17365b 55%,#0f2846)!important;position:relative;overflow:hidden}.airplane-cabin:after{content:"AIRPLANE MODE";position:absolute;right:-18px;top:28px;transform:rotate(90deg);font-size:10px;letter-spacing:.2em;opacity:.18}
.flight-window{height:180px!important;background:linear-gradient(#69b7ff 0 48%,#eaf7ff 49% 64%,#cde9ff 65% 100%)!important;position:relative;overflow:hidden;border-radius:24px}.flight-window:before{content:"";position:absolute;inset:12px;border:9px solid rgba(17,38,65,.5);border-radius:46% 46% 42% 42%/35% 35% 50% 50%}.cloud{position:absolute;width:80px;height:24px;background:#fff;border-radius:999px;opacity:.88}.cloud:before,.cloud:after{content:"";position:absolute;background:#fff;border-radius:50%}.cloud:before{width:34px;height:34px;left:14px;top:-16px}.cloud:after{width:45px;height:45px;right:9px;top:-23px}.cloud.c1{left:16%;top:55%}.cloud.c2{right:12%;top:34%;transform:scale(.75)}.plane-mark{position:absolute;left:50%;top:45%;transform:translate(-50%,-50%);width:58px;height:58px;border-radius:18px;background:#101d35;color:#fff;display:grid;place-items:center;font-weight:1000;font-size:30px;box-shadow:0 10px 22px rgba(0,0,0,.2)}
.story-actions{display:flex;gap:8px;flex-wrap:wrap}.anime-story-card{background:linear-gradient(160deg,#17263f,#0e182a)!important;border:1px solid rgba(255,255,255,.14)!important}.story-chip{background:rgba(255,255,255,.08)!important;border:1px solid rgba(255,255,255,.12)!important}
@media(max-width:520px){.flight-actions{grid-template-columns:1fr}.flight-route{grid-template-columns:1fr 62px 1fr}.flight-route strong{font-size:36px}.question-zone h1{font-size:clamp(28px,8.7vw,42px)}.answer-btn{font-size:clamp(20px,6vw,28px);min-height:76px}}

/* LIVNOI V1.5 — immersive flight focus + synonym survival */
.flight-facts{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin-top:16px}.flight-facts span{display:flex;flex-direction:column;padding:11px;border-radius:15px;background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.08)}.flight-facts small{font-size:9px;letter-spacing:.12em;opacity:.62}.flight-facts b{font-size:14px;margin-top:4px}
.seat-select,.ife-screen{margin-top:16px}.seat-current{font-weight:900;font-size:12px;background:rgba(255,255,255,.1);padding:7px 10px;border-radius:999px}.plane-cabin{padding:18px 14px 22px;border-radius:30px;background:linear-gradient(180deg,#152a45,#0a1727);border:1px solid rgba(255,255,255,.15);box-shadow:0 18px 45px rgba(0,0,0,.24)}.cockpit{width:64%;margin:0 auto 18px;padding:12px;border-radius:50% 50% 18px 18px;background:#203d61;text-align:center;font-size:10px;letter-spacing:.18em;color:#cfe8ff;border:1px solid rgba(255,255,255,.12)}.seat-map{display:grid;grid-template-columns:1fr 1fr 24px 1fr 1fr;gap:9px;max-width:430px;margin:auto}.seat{aspect-ratio:1/.9;border:0;border-radius:14px 14px 9px 9px;background:linear-gradient(#3d6e9e,#254b74);color:#fff;font-weight:950;box-shadow:inset 0 -5px 0 rgba(0,0,0,.16),0 5px 12px rgba(0,0,0,.12)}.seat:active{transform:translateY(2px)}.seat.selected{background:linear-gradient(#e6ff82,#a8d941);color:#13233a;box-shadow:0 0 0 3px #fff,0 0 24px rgba(216,255,100,.5)}.seat.occupied{background:#253344;color:#647589;opacity:.5;text-decoration:line-through}.aisle-gap{display:block}
.ife-screen{border-radius:32px;background:linear-gradient(160deg,#060b13,#101c2b);padding:10px;border:1px solid rgba(255,255,255,.12);box-shadow:0 22px 60px rgba(0,0,0,.36)}.ife-bezel{border-radius:26px;overflow:hidden;background:#0d1724;border:4px solid #222c38}.ife-topbar{height:48px;padding:0 16px;display:flex;align-items:center;justify-content:space-between;background:#08101a;border-bottom:1px solid rgba(255,255,255,.08);font-size:11px;letter-spacing:.1em}.ife-topbar>div{display:flex;align-items:center;gap:8px}.ife-dot{width:8px;height:8px;border-radius:50%;background:#bdf552;box-shadow:0 0 12px #bdf552}.flight-map{position:relative;min-height:360px;background:radial-gradient(circle at 30% 30%,#244e76 0,#132a44 38%,#08111e 76%);overflow:hidden}.flight-map:before{content:'';position:absolute;inset:0;background-image:linear-gradient(rgba(255,255,255,.035) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.035) 1px,transparent 1px);background-size:32px 32px}.globe{position:absolute;width:240px;height:240px;left:50%;top:45%;transform:translate(-50%,-50%);border-radius:50%;background:radial-gradient(circle at 36% 30%,#79d6ff 0 7%,#317caf 8% 43%,#134b7a 65%,#0b2d4a 100%);box-shadow:inset -30px -22px 60px rgba(0,0,0,.34),0 0 50px rgba(79,176,255,.18);overflow:hidden;border:1px solid rgba(255,255,255,.22)}.globe:after{content:'';position:absolute;inset:0;border-radius:50%;background:repeating-linear-gradient(0deg,transparent 0 26px,rgba(255,255,255,.08) 27px),repeating-linear-gradient(90deg,transparent 0 38px,rgba(255,255,255,.07) 39px)}.continent{position:absolute;background:#78a96f;opacity:.86;filter:drop-shadow(0 2px 3px rgba(0,0,0,.18))}.continent.one{width:72px;height:58px;left:34px;top:52px;border-radius:55% 42% 62% 33%;transform:rotate(18deg)}.continent.two{width:84px;height:62px;right:28px;top:78px;border-radius:34% 58% 42% 64%;transform:rotate(-16deg)}.continent.three{width:58px;height:42px;left:88px;bottom:35px;border-radius:44% 65% 38% 52%;transform:rotate(20deg)}.plane-on-globe{position:absolute;top:49%;left:12%;z-index:4;width:26px;height:26px;display:grid;place-items:center;border-radius:50%;background:#fff;color:#12284a;font-size:15px;box-shadow:0 0 0 4px rgba(255,255,255,.16),0 0 18px rgba(255,255,255,.6);transition:left .8s linear}.route-overlay{position:absolute;left:14px;right:14px;bottom:14px;padding:15px;border-radius:20px;background:rgba(4,10,18,.72);backdrop-filter:blur(12px);border:1px solid rgba(255,255,255,.1)}.route-overlay>small{font-size:9px;letter-spacing:.18em;color:#9fc9ea}.route-overlay h2{margin:4px 0 10px;display:flex;gap:10px;align-items:center;font-size:24px}.route-overlay h2 i{font-style:normal;opacity:.45}.route-progress{height:8px;background:rgba(255,255,255,.1);border-radius:999px;overflow:hidden}.route-progress span{display:block;height:100%;width:0;background:linear-gradient(90deg,#bff55e,#6edfff);border-radius:inherit;transition:width .8s linear}.route-stats{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin-top:10px}.route-stats span{display:flex;flex-direction:column}.route-stats small{font-size:8px;opacity:.55}.route-stats b{font-size:12px;margin-top:3px}.nearby-card{padding:14px 16px;background:#101e2e;border-top:1px solid rgba(255,255,255,.07);border-bottom:1px solid rgba(255,255,255,.07)}.nearby-card>small{font-size:9px;letter-spacing:.15em;color:#8da8be}.nearby-chips{display:flex;gap:7px;flex-wrap:wrap;margin-top:9px}.nearby-chips span{padding:7px 10px;border-radius:999px;background:#1b3148;border:1px solid rgba(255,255,255,.08);font-size:11px;color:#d9edff}.ife-screen .focus-shell,.ife-screen .anime-story-card{margin:12px;border-radius:22px}.ife-screen .anime-story-card{margin-bottom:16px}
.calendar-card{background:#101d2e;border:1px solid rgba(255,255,255,.12);border-radius:24px;padding:16px;margin-top:12px}.calendar-head{display:flex;align-items:flex-end;justify-content:space-between;gap:12px;margin-bottom:14px}.calendar-head h2{margin:3px 0 0}.calendar-legend{font-size:10px;color:#cbd9e8;display:flex;align-items:center;gap:5px}.done-dot,.pause-dot{width:8px;height:8px;border-radius:50%;display:inline-block}.done-dot{background:#b8f05c}.pause-dot{background:#ffc96a}.focus-calendar{display:grid;grid-template-columns:repeat(7,1fr);gap:6px}.cal-week{text-align:center;font-size:9px;font-weight:900;color:#7890a7;padding-bottom:4px}.cal-day{min-height:52px;border:1px solid rgba(255,255,255,.07);border-radius:12px;background:#14263a;color:#fff;padding:7px;display:flex;flex-direction:column;align-items:flex-start;justify-content:space-between}.cal-day.empty{background:transparent;border-color:transparent}.cal-day.done{background:linear-gradient(145deg,#244831,#18372a);border-color:rgba(184,240,92,.35)}.cal-day.paused{background:linear-gradient(145deg,#4b3d20,#362b19);border-color:rgba(255,201,106,.3)}.cal-day b{font-size:13px}.cal-day small{font-size:8px;opacity:.72}.day-detail{margin-top:12px;padding:12px;border-radius:14px;background:#0a1421;color:#dcecff;font-size:12px}.day-detail p{margin:5px 0 0;color:#8ba3b9}.day-flight{display:flex;justify-content:space-between;gap:10px;padding:9px 0;border-top:1px solid rgba(255,255,255,.07)}.day-flight:first-of-type{margin-top:8px}.day-flight span{color:#b8c9d9}.day-flight strong{text-transform:capitalize;text-align:right}.flight-history b{text-transform:capitalize}
.question-meta #questionDirection{max-width:62%;line-height:1.15}.battle-feedback.good:before{content:'POWER HIT · '}.battle-feedback.bad:before{content:'BEAST STRIKE · '}
@media(max-width:560px){.flight-facts{grid-template-columns:1fr 1fr}.flight-facts span:last-child{grid-column:1/-1}.flight-map{min-height:330px}.globe{width:210px;height:210px}.route-stats{gap:4px}.route-stats b{font-size:10px}.seat-map{gap:7px}.calendar-head{align-items:flex-start;flex-direction:column}.cal-day{min-height:46px;padding:5px}.day-flight{flex-direction:column}.day-flight strong{text-align:left}}
\n/* LIVNOI V1.6 — route-duration focus + readable dark site text */
.app-shell,.view,.page-head,.setting-card,.history-card,.progress-cards,.game-card,.level-strip{color:var(--ink)}
.page-head h1,.section-title h2,.setting-card label,.history-card h2,.game-card h3,.metric strong,.level-strip strong{color:var(--ink)!important}
.page-head p,.game-card p,.game-card small,.metric small,.level-strip small,.setting-card>small{color:var(--muted)!important}
.flight-board,.flight-board strong,.flight-board span,.flight-board small,.ife-screen,.ife-screen *{color:#fff}
.ife-screen .anime-story-card{background:#fffdf8!important;border-color:#dedbd2!important;color:var(--ink)!important}
.ife-screen .anime-story-card h2,.ife-screen .anime-story-card .short-story-text,.ife-screen .anime-story-card .short-story-text p,.ife-screen .anime-story-card .story-meta,.ife-screen .anime-story-card .story-chip,.ife-screen .anime-story-card .story-chip b{color:var(--ink)!important}
.ife-screen .anime-story-card .short-story-text{background:#fff!important;border-color:#e7e4da!important}
.ife-screen .anime-story-card .story-chip{background:#f3f0e9!important;border-color:#ddd8cc!important}
.focus-shell{color:#fff!important}.focus-shell small{color:#afb5b2!important}.focus-time{font-variant-numeric:tabular-nums;font-size:clamp(44px,12vw,66px)}
.flight-duration-note{margin:12px 0 4px;padding:11px 13px;border-radius:16px;background:rgba(255,255,255,.07);border:1px solid rgba(255,255,255,.11);display:flex;justify-content:space-between;gap:10px;align-items:center;text-align:left}
.flight-duration-note span{font-size:11px;color:#c8d8e5}.flight-duration-note b{font-size:11px;color:#d9ff65;white-space:nowrap}
.calendar-card{color:#fff}
@media(max-width:520px){.flight-duration-note{align-items:flex-start;flex-direction:column}.flight-duration-note b{white-space:normal}}
